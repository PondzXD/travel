rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "norrawit.pangpond@gmail.com" ||
        request.auth.token.email == "admin@thailandtravel.com"
      );
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      // ทุกคนที่เปิดเว็บอ่านรีวิวได้
      allow read: if true;
      // ผู้ใช้ที่ล็อกอินแล้วเขียนได้เฉพาะรีวิวที่เป็นของตัวเอง
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
