rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Keep this list in sync with firebase-config.js.
    // This is the real security boundary for Firestore writes.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "norrawit.pangpond@gmail.com" ||
        request.auth.token.email == "admin@thailandtravel.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      // Admin membership must not be self-granted from the client.
      allow write: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
