rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    // Keep this list in sync with firebase-config.js.
    // This is the real security boundary for uploaded files.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "norrawit.pangpond@gmail.com" ||
        request.auth.token.email == "admin@thailandtravel.com" ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
      );
    }

    match /places/{placeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
